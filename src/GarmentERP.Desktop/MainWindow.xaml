                        <TextBlock Text="🚚 Warehouse to Store Transfer" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,12"/>
                        <TextBlock Text="Select Variant to Dispatch:" Foreground="#94A3B8" FontSize="11"/>
                        <ComboBox ItemsSource="{Binding CatalogVariants}" SelectedItem="{Binding TransferSelectedVariant}" DisplayMemberPath="SKU" Background="#1E293B" Foreground="#FFFFFF" BorderBrush="#475569" Padding="6" Margin="0,2,0,10"/>

                        <TextBlock Text="Transfer Quantity:" Foreground="#94A3B8" FontSize="11"/>
