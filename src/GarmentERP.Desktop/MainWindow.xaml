<Window x:Class="GarmentERP.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:GarmentERP.Desktop.ViewModels"
        mc:Ignorable="d"
        Title="Garment Store POS &amp; Retail ERP — Enterprise System"
        Height="850" Width="1380"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#0F172A"
        FontFamily="Segoe UI"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- ========================================================= -->
        <!-- MODERN HIGH-CONTRAST DARK THEME STYLES                   -->
        <!-- ========================================================= -->

        <!-- 1. DataGrid Column Header Style -->
        <Style x:Key="ModernDataGridColumnHeader" TargetType="{x:Type DataGridColumnHeader}">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type DataGridColumnHeader}">
                        <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="0,0,1,1" Padding="10,8">
                            <ContentPresenter TextBlock.Foreground="#F8FAFC" TextBlock.FontWeight="Bold" TextBlock.FontSize="11" HorizontalAlignment="Left" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#334155"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 2. Global DataGrid Style -->
        <Style TargetType="{x:Type DataGrid}">
            <Setter Property="Background" Value="#0F172A"/>
            <Setter Property="RowBackground" Value="#1E293B"/>
            <Setter Property="AlternatingRowBackground" Value="#162032"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#334155"/>
            <Setter Property="VerticalGridLinesBrush" Value="Transparent"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="ColumnHeaderStyle" Value="{StaticResource ModernDataGridColumnHeader}"/>
        </Style>

        <Style TargetType="{x:Type DataGridColumnHeader}" BasedOn="{StaticResource ModernDataGridColumnHeader}"/>

        <!-- 3. Global Dark ScrollBar Style -->
        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Background" Value="#0F172A"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Background="#0F172A">
                            <Track x:Name="PART_Track" IsDirectionReversed="true">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.LineUpCommand}" Opacity="0" Focusable="False" Height="0" Width="0"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Border Background="#475569" CornerRadius="4" Margin="2"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#64748B"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter Property="Background" Value="#94A3B8"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.LineDownCommand}" Opacity="0" Focusable="False" Height="0" Width="0"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter Property="Height" Value="8"/>
                                <Setter Property="MinHeight" Value="8"/>
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="false"/>
                            </Trigger>
                            <Trigger Property="Orientation" Value="Vertical">
                                <Setter Property="Width" Value="8"/>
                                <Setter Property="MinWidth" Value="8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="11,7"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="BorderThickness" Value="0,0,0,3"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4,4,0,0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                    <Setter Property="Background" Value="#334155"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Top App Bar & Sync Header -->
            <RowDefinition Height="60"/>
            <!-- Module Navigation Bar -->
            <RowDefinition Height="Auto"/>
            <!-- Dynamic Content (POS or Module Views) -->
            <RowDefinition Height="*"/>
            <!-- Footer Status Bar -->
            <RowDefinition Height="36"/>
        </Grid.RowDefinitions>

        <!-- ======================================================== -->
        <!-- ROW 0: TOP APP BAR & LIVE SYNC / LICENSE HEADER -->
        <!-- ======================================================== -->
        <Border Grid.Row="0" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="0,0,0,1" Padding="15,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Branding -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="👗 GRAND FASHION STORE" FontSize="19" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                    <Border Background="#1E293B" CornerRadius="4" Margin="14,0,0,0" Padding="8,4" VerticalAlignment="Center">
                        <TextBlock Text="{Binding CounterInfoText}" FontSize="11" Foreground="#94A3B8"/>
                    </Border>
                </StackPanel>

                <!-- Right Header Actions & Live Sync Pill -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="📊 Shift Z-Report" Command="{Binding GenerateShiftZReportCommand}" Background="#334155" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="12" Padding="10,5" Margin="0,0,10,0" BorderThickness="0" Cursor="Hand"/>

                    <!-- License Badge -->
                    <Border Background="#064E3B" CornerRadius="4" Padding="10,5" Margin="0,0,10,0">
                        <TextBlock Text="{Binding LicenseBadgeText}" FontSize="11" FontWeight="SemiBold" Foreground="#6EE7B7"/>
                    </Border>

                    <!-- POSRES DataSync Queue Pill -->
                    <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="4" Padding="10,4" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🔄 SYNC: " FontSize="11" FontWeight="Bold" Foreground="#94A3B8" VerticalAlignment="Center"/>
                            <TextBlock Text="Pending: " FontSize="11" Foreground="#F59E0B" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding SyncPendingCount}" FontSize="12" FontWeight="Bold" Foreground="#FCD34D" Margin="2,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Done: " FontSize="11" Foreground="#10B981" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding SyncDoneCount}" FontSize="12" FontWeight="Bold" Foreground="#6EE7B7" Margin="2,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Failed: " FontSize="11" Foreground="#EF4444" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding SyncFailedCount}" FontSize="12" FontWeight="Bold" Foreground="#FCA5A5" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Button Content="Sync Now" Command="{Binding ForceSyncCommand}" Background="#2563EB" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12" Padding="12,5" BorderThickness="0" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ======================================================== -->
        <!-- ROW 1: MODULE NAVIGATION BAR -->
        <!-- ======================================================== -->
        <Border Grid.Row="1" Background="#1E293B" BorderBrush="#334155" BorderThickness="0,0,0,1" Padding="8,4" MinHeight="46">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="🛒 POS [F2]" Command="{Binding NavigateToCommand}" CommandParameter="POS" Style="{StaticResource NavBtnStyle}" BorderBrush="#3B82F6" Foreground="#FFFFFF"/>
                <Button Content="📊 Dashboard" Command="{Binding NavigateToCommand}" CommandParameter="DASHBOARD" Style="{StaticResource NavBtnStyle}"/>
                <Button Content="👗 Products" Command="{Binding NavigateToCommand}" CommandParameter="PRODUCTS" Style="{StaticResource NavBtnStyle}"/>
                <Button Content="📦 Inventory" Command="{Binding NavigateToCommand}" CommandParameter="INVENTORY" Style="{StaticResource NavBtnStyle}"/>
                <Button Content="📥 Purchases" Command="{Binding NavigateToCommand}" CommandParameter="PURCHASES" Style="{StaticResource NavBtnStyle}"/>
                <Button Content="🚚 Transfers" Command="{Binding NavigateToCommand}" CommandParameter="TRANSFERS" Style="{StaticResource NavBtnStyle}"/>
                <Button Content="👥 Customers" Command="{Binding NavigateToCommand}" CommandParameter="CUSTOMERS" Style="{StaticResource NavBtnStyle}"/>
                <Button Content="🔄 Returns" Command="{Binding NavigateToCommand}" CommandParameter="RETURNS" Style="{StaticResource NavBtnStyle}"/>
                <Button Content="💰 Accounting" Command="{Binding NavigateToCommand}" CommandParameter="ACCOUNTING" Style="{StaticResource NavBtnStyle}"/>
                <Button Content="📑 Reports" Command="{Binding NavigateToCommand}" CommandParameter="REPORTS" Style="{StaticResource NavBtnStyle}"/>
                <Button Content="📡 DataSync" Command="{Binding NavigateToCommand}" CommandParameter="SYNC" Style="{StaticResource NavBtnStyle}"/>
                <Button Content="⚙️ Settings" Command="{Binding NavigateToCommand}" CommandParameter="SETTINGS" Style="{StaticResource NavBtnStyle}"/>
            </StackPanel>
        </Border>

        <!-- ======================================================== -->
        <!-- ROW 2: DYNAMIC CONTENT TABS -->
        <!-- ======================================================== -->
        <Grid Grid.Row="2" Background="#0B132B">

            <!-- ==================================================== -->
            <!-- TAB 1: POS BILLING COUNTER VIEW -->
            <!-- ==================================================== -->
            <Grid Visibility="{Binding IsPosActive, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Barcode Bar with Scanner Mode Switcher -->
                <Border Grid.Row="0" Background="#1E293B" BorderBrush="#334155" BorderThickness="0,0,0,1" Padding="15,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Row 0: Barcode Scan Input -->
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="SCAN BARCODE / SKU:" FontWeight="Bold" FontSize="13" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <TextBox x:Name="TxtBarcode" Grid.Column="1" Text="{Binding BarcodeScanInput, UpdateSourceTrigger=PropertyChanged}" FontSize="16" FontWeight="SemiBold" Padding="10,6" VerticalContentAlignment="Center" Background="#0F172A" Foreground="#FFFFFF" BorderBrush="#475569" KeyDown="TxtBarcode_KeyDown"/>
                            <Button Grid.Column="2" Content="+ ADD ITEM (Enter)" Command="{Binding ScanBarcodeCommand}" Background="#2563EB" Foreground="#FFFFFF" FontWeight="Bold" FontSize="13" Padding="16,7" Margin="10,0,0,0" BorderThickness="0" Cursor="Hand"/>
                            <Button Grid.Column="3" Content="🔍 Search Item (F1)" Command="{Binding OpenProductSearchModalCommand}" Background="#334155" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="13" Padding="14,7" Margin="8,0,0,0" BorderThickness="0" Cursor="Hand" Click="BtnSearchItem_Click"/>
                            <Button Grid.Column="4" Content="🖨 Re-print (F12)" Command="{Binding PrintLastReceiptCommand}" Background="#475569" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="13" Padding="12,7" Margin="8,0,0,0" BorderThickness="0" Cursor="Hand"/>
                        </Grid>

                        <!-- Row 1: Scanner Input Mode Switcher & Quick Demo -->
                        <Grid Grid.Row="1" Margin="0,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="SCANNER SOURCE:" FontSize="11" FontWeight="Bold" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,10,0"/>

                            <!-- 3-Way Mode Switch -->
                            <Border Grid.Column="1" Background="#0F172A" CornerRadius="6" BorderBrush="#334155" BorderThickness="1" Padding="3">
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="🔫 Real USB/Laser" Command="{Binding SetScannerModeCommand}" CommandParameter="PHYSICAL"
                                            Background="#1E293B" Foreground="#F8FAFC" FontSize="11" FontWeight="SemiBold" Padding="12,5" BorderThickness="0" Cursor="Hand"/>
                                    <Button Content="📱 Android WiFi Scanner" Command="{Binding SetScannerModeCommand}" CommandParameter="MOBILE"
                                            Background="#064E3B" Foreground="#34D399" FontSize="11" FontWeight="Bold" Padding="12,5" BorderThickness="0" Cursor="Hand" Margin="4,0"/>
                                    <Button Content="⚡ Demo Mode" Command="{Binding SetScannerModeCommand}" CommandParameter="DEMO"
                                            Background="#1E3A8A" Foreground="#93C5FD" FontSize="11" FontWeight="SemiBold" Padding="12,5" BorderThickness="0" Cursor="Hand"/>
                                </StackPanel>
                            </Border>

                            <!-- Quick Demo Scans Bar (Active in Demo Mode) -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="14,0,0,0" Visibility="{Binding IsDemoScanner, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Quick Demo Scans:" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <Button Content="👕 Shirt S (8900327943047)" Command="{Binding SimulateBarcodeScanCommand}" CommandParameter="8900327943047" Background="#1E293B" Foreground="#38BDF8" BorderBrush="#334155" BorderThickness="1" Padding="8,4" FontSize="11" Cursor="Hand" Margin="0,0,6,0"/>
                                <Button Content="👕 Shirt XL (8900734656318)" Command="{Binding SimulateBarcodeScanCommand}" CommandParameter="8900734656318" Background="#1E293B" Foreground="#38BDF8" BorderBrush="#334155" BorderThickness="1" Padding="8,4" FontSize="11" Cursor="Hand" Margin="0,0,6,0"/>
                                <Button Content="👕 Slim Fit L (8900450996935)" Command="{Binding SimulateBarcodeScanCommand}" CommandParameter="8900450996935" Background="#1E293B" Foreground="#38BDF8" BorderBrush="#334155" BorderThickness="1" Padding="8,4" FontSize="11" Cursor="Hand"/>
                            </StackPanel>

                            <!-- Mobile WiFi Setup Button & Device Status -->
                            <StackPanel Grid.Column="3" Orientation="Horizontal">
                                <TextBlock Text="{Binding ConnectedMobileDevice}" FontSize="11" Foreground="#34D399" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <Button Content="📱 Pair Mobile Phone (QR Code)" Command="{Binding OpenMobileScannerSetupCommand}" Background="#059669" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11" Padding="14,6" BorderThickness="0" Cursor="Hand"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Main Cart & Billing Screen -->
                <Grid Grid.Row="1" Margin="15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="380"/>
                    </Grid.ColumnDefinitions>

                    <!-- Cart DataGrid -->
                    <Border Grid.Column="0" Background="#1E293B" CornerRadius="8" Padding="12" Margin="0,0,15,0" BorderBrush="#334155" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🛒 ACTIVE BILLING CART" FontSize="14" FontWeight="Bold" Foreground="#E2E8F0" VerticalAlignment="Center"/>
                                    <Border Background="#064E3B" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center" ToolTip="Every scanned item is instantly auto-saved to disk. Fully protected against power-cuts, freezes and crashes.">
                                        <TextBlock Text="⚡ Power-Loss Protected" FontSize="10" FontWeight="Bold" Foreground="#34D399"/>
                                    </Border>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding IsCrashRecoveredCart, Converter={StaticResource BoolToVis}}">
                                    <Border Background="#7C2D12" CornerRadius="4" Padding="8,3" Margin="0,0,8,0" VerticalAlignment="Center">
                                        <TextBlock Text="⚡ Unsaved Cart Restored After System Crash / Power-Cut" FontSize="11" FontWeight="Bold" Foreground="#FDBA74"/>
                                    </Border>
                                    <Button Content="Discard" Command="{Binding ClearCartCommand}" Background="#DC2626" Foreground="#FFFFFF" FontSize="10" FontWeight="Bold" Padding="8,3" BorderThickness="0" Cursor="Hand" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>

                            <DataGrid Grid.Row="1" ItemsSource="{Binding CartItems}" AutoGenerateColumns="False" CanUserAddRows="False" Background="#0F172A" RowBackground="#1E293B" AlternatingRowBackground="#162032" Foreground="#FFFFFF" BorderThickness="0" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#334155" ColumnHeaderStyle="{StaticResource ModernDataGridColumnHeader}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="BARCODE" Binding="{Binding Barcode}" Width="130"/>
                                    <DataGridTextColumn Header="PRODUCT &amp; VARIANT" Binding="{Binding DisplayTitle}" Width="*" FontWeight="SemiBold"/>
                                    <DataGridTextColumn Header="MRP" Binding="{Binding MRP, StringFormat='₹{0:N2}'}" Width="85"/>
                                    <DataGridTextColumn Header="PRICE" Binding="{Binding UnitPrice, StringFormat='₹{0:N2}'}" Width="85"/>
                                    <DataGridTextColumn Header="QTY" Binding="{Binding Quantity}" Width="60"/>
                                    <DataGridTextColumn Header="DISC" Binding="{Binding DiscountAmount, StringFormat='₹{0:N2}'}" Width="75"/>
                                    <DataGridTextColumn Header="TOTAL" Binding="{Binding LineTotal, StringFormat='₹{0:N2}'}" Width="95" FontWeight="Bold"/>
                                    <DataGridTemplateColumn Width="50">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="✕" Command="{Binding DataContext.RemoveLineItemCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Background="Transparent" Foreground="#EF4444" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <!-- Right Summary Panel -->
                    <Border Grid.Column="1" Background="#1E293B" CornerRadius="8" Padding="16" BorderBrush="#334155" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Customer Card -->
                            <Border Grid.Row="0" Background="#0F172A" CornerRadius="6" Padding="12" Margin="0,0,0,12" BorderBrush="#334155" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="CUSTOMER (F5)" FontSize="10" FontWeight="Bold" Foreground="#94A3B8"/>
                                        <TextBlock Text="{Binding CustomerName}" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,2,0,0"/>
                                        <TextBlock Text="{Binding CustomerPhone, StringFormat='Phone: {0}'}" FontSize="12" Foreground="#CBD5E1"/>
                                        <TextBlock Text="{Binding CustomerLoyaltyPoints, StringFormat='Points: {0} pts'}" FontSize="12" Foreground="#F59E0B" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Change" Command="{Binding OpenCustomerModalCommand}" Background="#334155" Foreground="#FFFFFF" Padding="8,4" FontSize="11" VerticalAlignment="Center" BorderThickness="0" Cursor="Hand"/>
                                </Grid>
                            </Border>

                            <!-- Summary Figures -->
                            <StackPanel Grid.Row="1" Margin="0,0,0,15">
                                <TextBlock Text="BILL SUMMARY" FontSize="12" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,8"/>
                                <Grid Margin="0,3">
                                    <TextBlock Text="Sub Total:" Foreground="#CBD5E1"/>
                                    <TextBlock Text="{Binding SubTotal, StringFormat='₹{0:N2}'}" HorizontalAlignment="Right" Foreground="#FFFFFF" FontWeight="SemiBold"/>
                                </Grid>
                                <Grid Margin="0,3">
                                    <TextBlock Text="Discount (F4):" Foreground="#CBD5E1"/>
                                    <TextBlock Text="{Binding InvoiceDiscount, StringFormat='-₹{0:N2}'}" HorizontalAlignment="Right" Foreground="#EF4444" FontWeight="SemiBold"/>
                                </Grid>
                                <Grid Margin="0,3">
                                    <TextBlock Text="Apparel GST (5%/12%):" Foreground="#CBD5E1"/>
                                    <TextBlock Text="{Binding TaxAmount, StringFormat='₹{0:N2}'}" HorizontalAlignment="Right" Foreground="#FFFFFF" FontWeight="SemiBold"/>
                                </Grid>
                                <Grid Margin="0,3">
                                    <TextBlock Text="Round Off:" Foreground="#CBD5E1"/>
                                    <TextBlock Text="{Binding RoundOff, StringFormat='₹{0:N2}'}" HorizontalAlignment="Right" Foreground="#94A3B8"/>
                                </Grid>
                                <Border Height="1" Background="#334155" Margin="0,8"/>
                                <Grid Margin="0,4">
                                    <TextBlock Text="GRAND TOTAL:" FontSize="16" FontWeight="Bold" Foreground="#10B981" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding GrandTotal, StringFormat='₹{0:N2}'}" FontSize="24" FontWeight="Bold" Foreground="#10B981" HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>

                            <!-- Action Buttons -->
                            <StackPanel Grid.Row="3">
                                <Button Content="⚡ QUICK CASH BILL (F10)" Command="{Binding QuickCashCheckoutCommand}" Background="#059669" Foreground="#FFFFFF" FontSize="16" FontWeight="Bold" Padding="0,14" Margin="0,0,0,8" BorderThickness="0" Cursor="Hand"/>
                                <Button Content="💳 SPLIT / UPI / CARD (F9)" Command="{Binding OpenSplitPaymentModalCommand}" Background="#2563EB" Foreground="#FFFFFF" FontSize="15" FontWeight="Bold" Padding="0,12" Margin="0,0,0,8" BorderThickness="0" Cursor="Hand"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="⏸ Hold Bill (F6)" Command="{Binding HoldCurrentBillCommand}" Background="#334155" Foreground="#FFFFFF" FontWeight="SemiBold" Padding="0,8" Margin="0,0,4,0" BorderThickness="0" Cursor="Hand"/>
                                    <Button Grid.Column="1" Content="▶ Resume (F7)" Command="{Binding OpenHeldBillsModalCommand}" Background="#334155" Foreground="#FFFFFF" FontWeight="SemiBold" Padding="0,8" Margin="4,0,0,0" BorderThickness="0" Cursor="Hand"/>
                                </Grid>
                                <Button Content="✕ Clear Active Cart" Command="{Binding ClearCartCommand}" Background="#475569" Foreground="#FCA5A5" FontWeight="SemiBold" Padding="0,6" BorderThickness="0" Cursor="Hand"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- ==================================================== -->
            <!-- TAB 2: DASHBOARD VIEW -->
            <!-- ==================================================== -->
            <Grid Visibility="{Binding IsDashboardActive, Converter={StaticResource BoolToVis}}" Margin="20">
