                        <TextBlock Text="Transfer Notes:" Foreground="#94A3B8" FontSize="11"/>
                        <TextBox Text="{Binding TransferNotes}" Background="#0F172A" Foreground="#FFFFFF" Padding="6" Margin="0,2,0,15"/>

                        <Button Content="Dispatch Transfer" Command="{Binding DispatchTransferCommand}" Background="#2563EB" Foreground="#FFFFFF" FontWeight="Bold" Padding="0,10" BorderThickness="0" Cursor="Hand"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
