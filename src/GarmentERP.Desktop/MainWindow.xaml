                            <TextBox Grid.Column="0" Text="{Binding ReturnInvoiceLookupNo}" FontSize="15" Padding="8" Background="#0F172A" Foreground="#FFFFFF" BorderBrush="#475569"/>
                            <Button Grid.Column="1" Content="Lookup Invoice" Command="{Binding LookupReturnInvoiceCommand}" Background="#2563EB" Foreground="#FFFFFF" FontWeight="Bold" Padding="14,0" Margin="8,0,0,0" BorderThickness="0" Cursor="Hand"/>
