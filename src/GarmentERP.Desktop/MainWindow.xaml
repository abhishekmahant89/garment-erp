                    </StackPanel>
                    <Button Grid.Column="1" Content="✨ Generate 25-Variant Matrix (5 Sizes × 5 Colors)" Command="{Binding Generate25VariantMatrixCommand}" Background="#7C3AED" Foreground="#FFFFFF" FontWeight="Bold" Padding="16,8" BorderThickness="0" Cursor="Hand"/>
                </Grid>

                <TextBlock Grid.Row="1" Text="{Binding MatrixGenStatus}" Foreground="#34D399" FontWeight="SemiBold" Margin="0,0,0,10"/>

                <Border Grid.Row="2" Style="{StaticResource CardStyle}">
                    <DataGrid ItemsSource="{Binding CatalogVariants}" AutoGenerateColumns="False" CanUserAddRows="False" Background="#0F172A" RowBackground="#1E293B" AlternatingRowBackground="#162032" Foreground="#FFFFFF" BorderThickness="0" HeadersVisibility="Column" ColumnHeaderStyle="{StaticResource ModernDataGridColumnHeader}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="SKU" Binding="{Binding SKU}" Width="140" FontWeight="SemiBold"/>
                            <DataGridTextColumn Header="EAN-13 BARCODE" Binding="{Binding Barcode}" Width="140"/>
                            <DataGridTextColumn Header="PRODUCT" Binding="{Binding ProductName}" Width="*"/>
                            <DataGridTextColumn Header="SIZE" Binding="{Binding SizeName}" Width="70"/>
                            <DataGridTextColumn Header="COLOR" Binding="{Binding ColorName}" Width="90"/>
                            <DataGridTextColumn Header="PURCHASE" Binding="{Binding PurchasePrice, StringFormat='₹{0:N2}'}" Width="95"/>
                            <DataGridTextColumn Header="SELLING" Binding="{Binding SellingPrice, StringFormat='₹{0:N2}'}" Width="95"/>
                            <DataGridTextColumn Header="MRP" Binding="{Binding MRP, StringFormat='₹{0:N2}'}" Width="95"/>
                            <DataGridTextColumn Header="STOCK" Binding="{Binding StockQty}" Width="80" FontWeight="Bold"/>
                            <DataGridTemplateColumn Header="BARCODE LABEL" Width="115">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="🏷 Print Barcode" Command="{Binding DataContext.OpenBarcodeLabelModalCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Background="#1E293B" Foreground="#38BDF8" BorderBrush="#334155" BorderThickness="1" Padding="6,3" FontSize="11" FontWeight="SemiBold" Cursor="Hand"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>

            <!-- ==================================================== -->
            <!-- TAB 4: INVENTORY VIEW -->
            <!-- ==================================================== -->
            <Grid Visibility="{Binding IsInventoryActive, Converter={StaticResource BoolToVis}}" Margin="20">
