                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="340"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,15,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="📦 Multi-Location Inventory Balances" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,10"/>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding InventoryStockItems}" SelectedItem="{Binding SelectedInventoryItem}" AutoGenerateColumns="False" CanUserAddRows="False" Background="#0F172A" RowBackground="#1E293B" Foreground="#FFFFFF" BorderThickness="0" HeadersVisibility="Column" ColumnHeaderStyle="{StaticResource ModernDataGridColumnHeader}">
