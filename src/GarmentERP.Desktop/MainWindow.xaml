                        <TextBlock Text="Reason for Adjustment:" Foreground="#94A3B8" FontSize="11"/>
                        <TextBox Text="{Binding StockAdjustmentReason, UpdateSourceTrigger=PropertyChanged}" Background="#0F172A" Foreground="#FFFFFF" Padding="6" Margin="0,2,0,15"/>

                        <Button Content="Confirm Stock Adjustment" Command="{Binding AdjustStockCommand}" Background="#D97706" Foreground="#FFFFFF" FontWeight="Bold" Padding="0,10" BorderThickness="0" Cursor="Hand"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ==================================================== -->
            <!-- TAB 5: PURCHASES VIEW -->
            <!-- ==================================================== -->
            <Grid Visibility="{Binding IsPurchasesActive, Converter={StaticResource BoolToVis}}" Margin="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="380"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,15,0">
                    <StackPanel>
                        <TextBlock Text="📥 Inward Purchase Intake (GRN)" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,12"/>
                        <TextBlock Text="Supplier:" Foreground="#94A3B8" FontSize="11"/>
                        <ComboBox ItemsSource="{Binding SuppliersList}" SelectedItem="{Binding SelectedSupplier}" DisplayMemberPath="Name" Background="#1E293B" Foreground="#FFFFFF" BorderBrush="#475569" Padding="6" Margin="0,2,0,10"/>

                        <TextBlock Text="Supplier Invoice #:" Foreground="#94A3B8" FontSize="11"/>
                        <TextBox Text="{Binding PurchaseInvoiceNo}" Background="#0F172A" Foreground="#FFFFFF" Padding="6" Margin="0,2,0,10"/>

                        <TextBlock Text="Garment Variant:" Foreground="#94A3B8" FontSize="11"/>
