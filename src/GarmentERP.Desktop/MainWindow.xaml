                                <DataGridTextColumn Header="BARCODE" Binding="{Binding Barcode}" Width="130"/>
                                <DataGridTextColumn Header="ITEM" Binding="{Binding ProductName}" Width="*"/>
                                <DataGridTextColumn Header="SIZE" Binding="{Binding SizeName}" Width="60"/>
                                <DataGridTextColumn Header="COLOR" Binding="{Binding ColorName}" Width="80"/>
                                <DataGridTextColumn Header="STOCK QTY" Binding="{Binding StockQty}" Width="90" FontWeight="Bold"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!-- Stock Adjustment Panel -->
                <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="⚡ Stock Adjustment" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,12"/>
                        <TextBlock Text="Selected Variant:" Foreground="#94A3B8" FontSize="11"/>
                        <TextBlock Text="{Binding SelectedInventoryItem.ProductName, FallbackValue='(Click an item on left)'}" Foreground="#FFFFFF" FontWeight="Bold" Margin="0,2,0,10"/>

                        <TextBlock Text="Quantity Change (+/-):" Foreground="#94A3B8" FontSize="11"/>
