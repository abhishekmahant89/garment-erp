                            <TextBlock Text="TODAY SALES" FontSize="11" FontWeight="Bold" Foreground="#94A3B8"/>
                            <TextBlock Text="{Binding DashTodaySales, StringFormat='₹{0:N2}'}" FontSize="20" FontWeight="Bold" Foreground="#10B981" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="4,0,8,0">
                        <StackPanel>
                            <TextBlock Text="INVOICES BILLED" FontSize="11" FontWeight="Bold" Foreground="#94A3B8"/>
                            <TextBlock Text="{Binding DashInvoiceCount}" FontSize="20" FontWeight="Bold" Foreground="#38BDF8" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource CardStyle}" Margin="4,0,8,0">
                        <StackPanel>
                            <TextBlock Text="ITEMS SOLD" FontSize="11" FontWeight="Bold" Foreground="#94A3B8"/>
                            <TextBlock Text="{Binding DashItemsSold}" FontSize="20" FontWeight="Bold" Foreground="#A78BFA" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="3" Style="{StaticResource CardStyle}" Margin="4,0,8,0">
                        <StackPanel>
                            <TextBlock Text="CASH COLLECTION" FontSize="11" FontWeight="Bold" Foreground="#94A3B8"/>
                            <TextBlock Text="{Binding DashCashCollection, StringFormat='₹{0:N2}'}" FontSize="20" FontWeight="Bold" Foreground="#FBBF24" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="4" Style="{StaticResource CardStyle}" Margin="4,0,8,0">
                        <StackPanel>
                            <TextBlock Text="UPI / DIGITAL" FontSize="11" FontWeight="Bold" Foreground="#94A3B8"/>
                            <TextBlock Text="{Binding DashUpiCollection, StringFormat='₹{0:N2}'}" FontSize="20" FontWeight="Bold" Foreground="#34D399" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="5" Style="{StaticResource CardStyle}" Margin="4,0,0,0">
                        <StackPanel>
                            <TextBlock Text="LOW STOCK ALERTS" FontSize="11" FontWeight="Bold" Foreground="#94A3B8"/>
                            <TextBlock Text="{Binding DashLowStockAlerts}" FontSize="20" FontWeight="Bold" Foreground="#F87171" Margin="0,4,0,0"/>
