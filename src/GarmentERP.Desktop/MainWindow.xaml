                        <TextBlock Text="{Binding TrialBalanceCredits, StringFormat='Total Credits: ₹{0:N2}'}" Foreground="#FFFFFF"/>
                        <TextBlock Text="Status: BALANCED" Foreground="#34D399" FontWeight="Bold" Margin="0,4,0,0"/>
