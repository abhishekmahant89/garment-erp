                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                <TextBlock Text="Purchase Cost:" Foreground="#94A3B8" FontSize="11"/>
                                <TextBox Text="{Binding PurchasePrice}" Background="#0F172A" Foreground="#FFFFFF" Padding="6"/>
                            </StackPanel>
                        </Grid>

                        <Button Content="Receive Goods &amp; Update Stock" Command="{Binding SubmitPurchaseIntakeCommand}" Background="#059669" Foreground="#FFFFFF" FontWeight="Bold" Padding="0,10" Margin="0,10,0,0" BorderThickness="0" Cursor="Hand"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Purchase Inward History" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,10"/>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding PurchaseHistory}" AutoGenerateColumns="False" CanUserAddRows="False" Background="#0F172A" RowBackground="#1E293B" Foreground="#FFFFFF" BorderThickness="0" HeadersVisibility="Column" ColumnHeaderStyle="{StaticResource ModernDataGridColumnHeader}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="INVOICE #" Binding="{Binding InvoiceNumber}" Width="150" FontWeight="SemiBold"/>
                                <DataGridTextColumn Header="SUPPLIER" Binding="{Binding SupplierName}" Width="*"/>
                                <DataGridTextColumn Header="ITEMS" Binding="{Binding TotalItems}" Width="80"/>
                                <DataGridTextColumn Header="TOTAL AMOUNT" Binding="{Binding TotalAmount, StringFormat='₹{0:N2}'}" Width="120" FontWeight="Bold"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>

            <!-- ==================================================== -->
            <!-- TAB 6: STOCK TRANSFERS VIEW -->
            <!-- ==================================================== -->
            <Grid Visibility="{Binding IsTransfersActive, Converter={StaticResource BoolToVis}}" Margin="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="380"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,15,0">
