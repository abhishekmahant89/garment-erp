                                <DataGridTextColumn Header="EXPENSE TITLE" Binding="{Binding Title}" Width="*"/>
                                <DataGridTextColumn Header="CATEGORY" Binding="{Binding Notes}" Width="140"/>
                                <DataGridTextColumn Header="AMOUNT" Binding="{Binding Amount, StringFormat='₹{0:N2}'}" Width="120" FontWeight="Bold"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>

            <!-- ==================================================== -->
            <!-- TAB 10: GST & P/L REPORTS VIEW -->
            <!-- ==================================================== -->
            <Grid Visibility="{Binding IsReportsActive, Converter={StaticResource BoolToVis}}" Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- P/L Cards -->
                <Grid Grid.Row="0" Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="TOTAL REVENUE" FontSize="11" Foreground="#94A3B8" FontWeight="Bold"/>
                            <TextBlock Text="{Binding RptTotalRevenue, StringFormat='₹{0:N2}'}" FontSize="18" FontWeight="Bold" Foreground="#10B981" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="4,0,8,0">
                        <StackPanel>
                            <TextBlock Text="COST OF GOODS (COGS)" FontSize="11" Foreground="#94A3B8" FontWeight="Bold"/>
                            <TextBlock Text="{Binding RptCogs, StringFormat='₹{0:N2}'}" FontSize="18" FontWeight="Bold" Foreground="#F59E0B" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource CardStyle}" Margin="4,0,8,0">
                        <StackPanel>
                            <TextBlock Text="GROSS PROFIT" FontSize="11" Foreground="#94A3B8" FontWeight="Bold"/>
                            <TextBlock Text="{Binding RptGrossProfit, StringFormat='₹{0:N2}'}" FontSize="18" FontWeight="Bold" Foreground="#38BDF8" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="3" Style="{StaticResource CardStyle}" Margin="4,0,0,0">
                        <StackPanel>
                            <TextBlock Text="NET PROFIT" FontSize="11" Foreground="#94A3B8" FontWeight="Bold"/>
                            <TextBlock Text="{Binding RptNetProfit, StringFormat='₹{0:N2}'}" FontSize="18" FontWeight="Bold" Foreground="#34D399" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- GSTR-1 HSN Table -->
                <Border Grid.Row="1" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="GSTR-1 Indian Apparel GST Slabs (5% &amp; 12% Breakdown)" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,10"/>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding Gstr1HsnSummaries}" AutoGenerateColumns="False" CanUserAddRows="False" Background="#0F172A" RowBackground="#1E293B" Foreground="#FFFFFF" BorderThickness="0" HeadersVisibility="Column" ColumnHeaderStyle="{StaticResource ModernDataGridColumnHeader}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="HSN CODE" Binding="{Binding HsnCode}" Width="120" FontWeight="SemiBold"/>
                                <DataGridTextColumn Header="DESCRIPTION" Binding="{Binding Description}" Width="*"/>
                                <DataGridTextColumn Header="QTY" Binding="{Binding TotalQuantity}" Width="80"/>
                                <DataGridTextColumn Header="TAXABLE VALUE" Binding="{Binding TaxableAmount, StringFormat='₹{0:N2}'}" Width="140"/>
                                <DataGridTextColumn Header="CGST" Binding="{Binding CgstAmount, StringFormat='₹{0:N2}'}" Width="100"/>
                                <DataGridTextColumn Header="SGST" Binding="{Binding SgstAmount, StringFormat='₹{0:N2}'}" Width="100"/>
                                <DataGridTextColumn Header="TOTAL GST" Binding="{Binding TotalTaxAmount, StringFormat='₹{0:N2}'}" Width="120" FontWeight="Bold"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>

            <!-- ==================================================== -->
            <!-- TAB 11: DATA SYNC CENTER VIEW -->
            <!-- ==================================================== -->
            <Grid Visibility="{Binding IsSyncActive, Converter={StaticResource BoolToVis}}" Margin="20">
                <Border Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="📡 POSRES Offline/Cloud Outbox &amp; Inbox Monitor" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="Force Outbox Sync" Command="{Binding ForceSyncCommand}" Background="#2563EB" Foreground="#FFFFFF" FontWeight="Bold" Padding="14,6" BorderThickness="0" Cursor="Hand"/>
                        </Grid>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding OutboxList}" AutoGenerateColumns="False" CanUserAddRows="False" Background="#0F172A" RowBackground="#1E293B" Foreground="#FFFFFF" BorderThickness="0" HeadersVisibility="Column" ColumnHeaderStyle="{StaticResource ModernDataGridColumnHeader}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="EVENT ID" Binding="{Binding EventId}" Width="260"/>
                                <DataGridTextColumn Header="TYPE" Binding="{Binding EventType}" Width="120" FontWeight="SemiBold"/>
                                <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="100" FontWeight="Bold"/>
                                <DataGridTextColumn Header="RETRIES" Binding="{Binding RetryCount}" Width="70"/>
                                <DataGridTextColumn Header="CREATED AT (UTC)" Binding="{Binding CreatedAtUtc, StringFormat='dd-MM-yyyy HH:mm:ss'}" Width="160"/>
                                <DataGridTextColumn Header="PROCESSED AT (UTC)" Binding="{Binding ProcessedAtUtc, StringFormat='dd-MM-yyyy HH:mm:ss'}" Width="160"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>

            <!-- ==================================================== -->
            <!-- TAB 12: SETTINGS & HARDWARE VIEW -->
            <!-- ==================================================== -->
            <Grid Visibility="{Binding IsSettingsActive, Converter={StaticResource BoolToVis}}" Margin="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Card: Store Profile & License Server -->
                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,10,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="⚙️ Store Profile &amp; License Server" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,15"/>

                            <TextBlock Text="Store Legal Name:" Foreground="#94A3B8" FontSize="11"/>
                            <TextBox Text="{Binding SettingStoreName}" Background="#0F172A" Foreground="#FFFFFF" Padding="6" Margin="0,2,0,10"/>

                            <TextBlock Text="Branch / Showroom Name:" Foreground="#94A3B8" FontSize="11"/>
                            <TextBox Text="{Binding SettingBranchName}" Background="#0F172A" Foreground="#FFFFFF" Padding="6" Margin="0,2,0,10"/>

                            <TextBlock Text="Store GSTIN:" Foreground="#94A3B8" FontSize="11"/>
                            <TextBox Text="{Binding SettingGstin}" Background="#0F172A" Foreground="#FFFFFF" Padding="6" Margin="0,2,0,10"/>

                            <TextBlock Text="Hardware Machine Fingerprint (MPOS ID):" Foreground="#94A3B8" FontSize="11"/>
                            <TextBox Text="{Binding HardwareFingerprint}" IsReadOnly="True" Background="#0F172A" Foreground="#6EE7B7" FontWeight="Bold" Padding="6" Margin="0,2,0,10"/>

                            <TextBlock Text="Central License Server URL:" Foreground="#94A3B8" FontSize="11"/>
                            <TextBox Text="{Binding LicenseServerUrl}" IsReadOnly="True" Background="#0F172A" Foreground="#38BDF8" FontWeight="SemiBold" Padding="6" Margin="0,2,0,15"/>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="🔐 Verify Online License" Command="{Binding VerifyOnlineLicenseCommand}" Background="#0284C7" Foreground="#FFFFFF" FontWeight="Bold" Padding="0,10" Margin="0,0,5,0" BorderThickness="0" Cursor="Hand"/>
                                <Button Grid.Column="1" Content="💾 Encrypted Backup" Command="{Binding CreateBackupSnapshotCommand}" Background="#059669" Foreground="#FFFFFF" FontWeight="Bold" Padding="0,10" Margin="5,0,0,0" BorderThickness="0" Cursor="Hand"/>
                            </Grid>

                            <Button Content="Test License Server Telemetry" Command="{Binding TestErrorTelemetryCommand}" Background="#4F46E5" Foreground="#FFFFFF" FontWeight="Bold" Padding="0,8" Margin="0,0,0,10" BorderThickness="0" Cursor="Hand"/>

                            <TextBlock Text="{Binding SettingStatusMessage}" Foreground="#34D399" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- Right Card: Telegram Bot Integration -->
                <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="10,0,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="✈️ Telegram Bot Alert Integration" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,6"/>
                            <TextBlock Text="Real-time instant notifications directly to store owner's Telegram app for sales, cashier shifts, stock, and errors." FontSize="12" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,0,0,15"/>

                            <TextBlock Text="Telegram Bot Token:" Foreground="#94A3B8" FontSize="11"/>
                            <TextBox Text="{Binding TelegramBotToken, UpdateSourceTrigger=PropertyChanged}" Background="#0F172A" Foreground="#FFFFFF" Padding="6" Margin="0,2,0,10"/>

                            <TextBlock Text="Telegram Chat ID:" Foreground="#94A3B8" FontSize="11"/>
                            <TextBox Text="{Binding TelegramChatId, UpdateSourceTrigger=PropertyChanged}" Background="#0F172A" Foreground="#FFFFFF" Padding="6" Margin="0,2,0,15"/>

                            <Button Content="🔔 Send Test Alert to Telegram" Command="{Binding TestTelegramBotCommand}" Background="#2563EB" Foreground="#FFFFFF" FontSize="14" FontWeight="Bold" Padding="0,12" Margin="0,0,0,15" BorderThickness="0" Cursor="Hand"/>

                            <TextBlock Text="{Binding TelegramStatusMessage}" Foreground="#F59E0B" FontWeight="Bold" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,15"/>

                            <Border Background="#0F172A" CornerRadius="6" Padding="12" BorderBrush="#334155" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="📱 Automatic Alerts Triggered:" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,6"/>
                                    <TextBlock Text="• 🟢 POS App Startup &amp; Counter Online" Foreground="#CBD5E1" Margin="0,2"/>
                                    <TextBlock Text="• 🧾 Live Bill Completed (Invoice #, Total ₹, Items, Payment)" Foreground="#CBD5E1" Margin="0,2"/>
                                    <TextBlock Text="• 📊 Shift Closing Z-Report (Sales &amp; Cash Breakdown)" Foreground="#CBD5E1" Margin="0,2"/>
                                    <TextBlock Text="• 🚨 DataSync Error &amp; Network Outage Warning" Foreground="#CBD5E1" Margin="0,2"/>
                                    <TextBlock Text="• ⚠️ Application Crash Telemetry to License Server" Foreground="#CBD5E1" Margin="0,2"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

        </Grid>

        <!-- ======================================================== -->
        <!-- ROW 3: FOOTER STATUS BAR & KEYPAD LEGEND -->
        <!-- ======================================================== -->
        <Border Grid.Row="3" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="0,1,0,0" Padding="15,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" FontSize="12" FontWeight="SemiBold" Foreground="#38BDF8" VerticalAlignment="Center"/>

                <TextBlock Grid.Column="1" Text="F1 Search | F2 POS | F4 Discount | F5 Customer | F6 Hold | F7 Resume | F9 Split | F10 Cash | F11 Z-Report | F12 Re-print" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ======================================================== -->
        <!-- POPUP MODALS & DIALOGS -->
        <!-- ======================================================== -->

        <!-- MODAL: FAST PRODUCT & VARIANT SEARCH (F1) -->
        <Grid Background="#CC000000" Grid.Row="0" Grid.RowSpan="4" Panel.ZIndex="100" Visibility="{Binding IsProductSearchModalOpen, Converter={StaticResource BoolToVis}}">
            <Border Background="#1E293B" CornerRadius="10" Width="960" Height="620" Padding="24" BorderBrush="#334155" BorderThickness="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Title & Close -->
                        <RowDefinition Height="Auto"/>
                        <!-- Instant Search Bar -->
                        <RowDefinition Height="Auto"/>
                        <!-- Filtered Results Table -->
                        <RowDefinition Height="*"/>
                        <!-- Footer -->
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Row 0: Title & Help -->
                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="🔍 Fast Product &amp; Variant Search (F1)" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF"/>
                            <TextBlock Text="Instant live search across all products, sizes, colors, SKUs, and barcodes." FontSize="12" Foreground="#94A3B8" Margin="0,3,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="✕" Command="{Binding OpenProductSearchModalCommand}" Background="Transparent" Foreground="#94A3B8" FontSize="18" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Padding="8,2" VerticalAlignment="Top"/>
                    </Grid>

                    <!-- Row 1: Instant Search Box -->
                    <Border Grid.Row="1" Background="#0F172A" CornerRadius="6" BorderBrush="#38BDF8" BorderThickness="1.5" Padding="4" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="🔎" FontSize="16" Foreground="#38BDF8" VerticalAlignment="Center" Margin="10,0,8,0"/>
                            <TextBox x:Name="TxtProductSearchInput" Grid.Column="1" Text="{Binding ProductSearchQuery, UpdateSourceTrigger=PropertyChanged}" FontSize="15" FontWeight="SemiBold" Background="Transparent" Foreground="#FFFFFF" BorderThickness="0" VerticalContentAlignment="Center" Padding="4,8" KeyDown="TxtProductSearchInput_KeyDown"/>
                            <TextBlock Grid.Column="2" Text="{Binding SearchFilteredVariants.Count, StringFormat='{}{0} items found'}" FontSize="12" FontWeight="SemiBold" Foreground="#38BDF8" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        </Grid>
                    </Border>

                    <!-- Row 2: Results Table -->
                    <Border Grid.Row="2" Background="#0F172A" CornerRadius="6" BorderBrush="#334155" BorderThickness="1">
                        <DataGrid ItemsSource="{Binding SearchFilteredVariants}" AutoGenerateColumns="False" CanUserAddRows="False" Background="#0F172A" RowBackground="#1E293B" AlternatingRowBackground="#162032" Foreground="#FFFFFF" BorderThickness="0" HeadersVisibility="Column" ColumnHeaderStyle="{StaticResource ModernDataGridColumnHeader}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="SKU" Binding="{Binding SKU}" Width="150" FontWeight="SemiBold"/>
                                <DataGridTextColumn Header="BARCODE" Binding="{Binding Barcode}" Width="140"/>
                                <DataGridTextColumn Header="PRODUCT NAME" Binding="{Binding ProductName}" Width="*"/>
                                <DataGridTextColumn Header="SIZE" Binding="{Binding SizeName}" Width="80"/>
                                <DataGridTextColumn Header="COLOR" Binding="{Binding ColorName}" Width="90"/>
                                <DataGridTextColumn Header="PRICE" Binding="{Binding SellingPrice, StringFormat='₹{0:N2}'}" Width="95" FontWeight="SemiBold"/>
                                <DataGridTemplateColumn Header="STOCK" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Center" Background="#064E3B">
                                                <TextBlock Text="{Binding StockQty, StringFormat='{}{0} in stock'}" FontSize="11" FontWeight="Bold" Foreground="#34D399"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="+ Add Cart" Command="{Binding DataContext.AddVariantToCartFromSearchCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Background="#2563EB" Foreground="#FFFFFF" FontWeight="Bold" Padding="10,4" BorderThickness="0" Cursor="Hand"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <!-- Row 3: Footer -->
                    <Grid Grid.Row="3" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="💡 Type to filter in real-time. Press Enter to add first match. Click '+ Add Cart' or press Escape to close." FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="Close Search (Esc)" Command="{Binding OpenProductSearchModalCommand}" Background="#334155" Foreground="#FFFFFF" FontWeight="SemiBold" Padding="16,8" BorderThickness="0" Cursor="Hand"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- MODAL: SPLIT PAYMENT (F9) -->
        <Grid Background="#CC000000" Grid.Row="0" Grid.RowSpan="4" Panel.ZIndex="100" Visibility="{Binding IsPaymentModalOpen, Converter={StaticResource BoolToVis}}">
            <Border Background="#1E293B" CornerRadius="8" Width="500" Padding="20" VerticalAlignment="Center" BorderBrush="#334155" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="💳 Split / Multi-Tender Checkout (F9)" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,12"/>
                    <TextBlock Text="{Binding GrandTotal, StringFormat='Net Payable: ₹{0:N2}'}" FontSize="20" FontWeight="Bold" Foreground="#10B981" Margin="0,0,0,12"/>

                    <TextBlock Text="Cash Amount:" Foreground="#94A3B8" FontSize="11"/>
                    <TextBox Text="{Binding TenderCash, UpdateSourceTrigger=PropertyChanged}" Background="#0F172A" Foreground="#FFFFFF" FontSize="16" Padding="6" Margin="0,2,0,10"/>

                    <TextBlock Text="Card Amount:" Foreground="#94A3B8" FontSize="11"/>
                    <TextBox Text="{Binding TenderCard, UpdateSourceTrigger=PropertyChanged}" Background="#0F172A" Foreground="#FFFFFF" FontSize="16" Padding="6" Margin="0,2,0,10"/>

                    <TextBlock Text="UPI Amount:" Foreground="#94A3B8" FontSize="11"/>
                    <TextBox Text="{Binding TenderUpi, UpdateSourceTrigger=PropertyChanged}" Background="#0F172A" Foreground="#FFFFFF" FontSize="16" Padding="6" Margin="0,2,0,15"/>

                    <TextBlock Text="{Binding SplitPaymentSummary}" Foreground="#F59E0B" FontWeight="SemiBold" Margin="0,0,0,15"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Confirm Payment" Command="{Binding ConfirmSplitPaymentCommand}" Background="#059669" Foreground="#FFFFFF" FontWeight="Bold" Padding="0,10" Margin="0,0,5,0" BorderThickness="0" Cursor="Hand"/>
                        <Button Grid.Column="1" Content="Cancel" Command="{Binding OpenSplitPaymentModalCommand}" Background="#475569" Foreground="#FFFFFF" FontWeight="Bold" Padding="0,10" Margin="5,0,0,0" BorderThickness="0" Cursor="Hand"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- MODAL: THERMAL RECEIPT PREVIEW (80mm) -->
        <Grid Background="#CC000000" Grid.Row="0" Grid.RowSpan="4" Panel.ZIndex="100" Visibility="{Binding IsReceiptModalOpen, Converter={StaticResource BoolToVis}}">
            <Border Background="#1E293B" CornerRadius="8" Width="450" Height="600" Padding="20" BorderBrush="#334155" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="🖨 ESC/POS 80mm Thermal Receipt Preview" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,10"/>
                    <Border Grid.Row="1" Background="#0F172A" CornerRadius="6" BorderBrush="#334155" BorderThickness="1">
                        <ScrollViewer Padding="15">
                            <TextBlock Text="{Binding ReceiptPreviewText}" FontFamily="Consolas, Courier New" FontSize="12" Foreground="#F8FAFC"/>
                        </ScrollViewer>
                    </Border>
                    <Button Grid.Row="2" Content="Close Receipt" Command="{Binding CloseReceiptModalCommand}" Background="#2563EB" Foreground="#FFFFFF" FontWeight="Bold" Padding="0,8" Margin="0,10,0,0" BorderThickness="0" Cursor="Hand"/>
                </Grid>
            </Border>
        </Grid>

        <!-- MODAL: SHIFT Z-REPORT (F11) -->
        <Grid Background="#CC000000" Grid.Row="0" Grid.RowSpan="4" Panel.ZIndex="100" Visibility="{Binding IsZReportModalOpen, Converter={StaticResource BoolToVis}}">
            <Border Background="#1E293B" CornerRadius="8" Width="450" Height="600" Padding="20" BorderBrush="#334155" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="📊 Day-End Cashier Shift Z-Report" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,10"/>
                    <Border Grid.Row="1" Background="#0F172A" CornerRadius="6" BorderBrush="#334155" BorderThickness="1">
                        <ScrollViewer Padding="15">
                            <TextBlock Text="{Binding ZReportText}" FontFamily="Consolas, Courier New" FontSize="12" Foreground="#F8FAFC"/>
                        </ScrollViewer>
                    </Border>
                    <Button Grid.Row="2" Content="Close Z-Report" Command="{Binding CloseZReportModalCommand}" Background="#2563EB" Foreground="#FFFFFF" FontWeight="Bold" Padding="0,8" Margin="0,10,0,0" BorderThickness="0" Cursor="Hand"/>
                </Grid>
            </Border>
        </Grid>

        <!-- MODAL: ANDROID WIFI MOBILE SCANNER SETUP -->
        <Grid Background="#CC000000" Grid.Row="0" Grid.RowSpan="4" Panel.ZIndex="100" Visibility="{Binding IsMobileScannerModalOpen, Converter={StaticResource BoolToVis}}">
            <Border Background="#1E293B" CornerRadius="10" Width="680" Padding="24" BorderBrush="#334155" BorderThickness="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="📱 Connect Android Phone as WiFi Barcode Scanner" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF"/>
                            <TextBlock Text="Turns your smartphone camera into a wireless laser barcode scanner for this POS." FontSize="12" Foreground="#94A3B8" Margin="0,3,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="✕" Command="{Binding CloseMobileScannerSetupCommand}" Background="Transparent" Foreground="#94A3B8" FontSize="18" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Padding="8,2" VerticalAlignment="Top"/>
                    </Grid>

                    <!-- Body: QR Code & Connection Details -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="230"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: Big QR Code Image -->
                        <Border Grid.Column="0" Background="#FFFFFF" CornerRadius="8" Padding="12" VerticalAlignment="Top" HorizontalAlignment="Center" BorderBrush="#38BDF8" BorderThickness="2">
                            <Image Source="{Binding MobileScannerQrImage}" Width="190" Height="190" Stretch="Uniform"/>
                        </Border>

                        <!-- Right: Steps & Status -->
                        <StackPanel Grid.Column="1" Margin="20,0,0,0">
                            <TextBlock Text="EASY 2-STEP PAIRING:" FontWeight="Bold" FontSize="13" Foreground="#38BDF8" Margin="0,0,0,8"/>

                            <Border Background="#0F172A" CornerRadius="6" Padding="10" Margin="0,0,0,8" BorderBrush="#334155" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="1. Connect phone to the same Wi-Fi network as this PC." FontSize="12" Foreground="#E2E8F0"/>
                                    <TextBlock Text="2. Scan the QR code with phone camera, or open URL in Chrome:" FontSize="12" Foreground="#E2E8F0" Margin="0,4,0,4"/>
                                    <TextBox Text="{Binding MobileScannerUrl}" IsReadOnly="True" FontSize="13" FontWeight="Bold" Foreground="#38BDF8" Background="#1E293B" BorderBrush="#475569" Padding="6,4"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#0F172A" CornerRadius="6" Padding="10" Margin="0,0,0,10" BorderBrush="#334155" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="PHONE CONNECTION STATUS:" FontSize="11" FontWeight="Bold" Foreground="#94A3B8"/>
                                    <TextBlock Text="{Binding ConnectedMobileDevice}" FontSize="13" FontWeight="Bold" Foreground="#34D399" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="DEMO TESTING (Instant 1-Click Simulation):" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" Margin="0,4,0,6"/>
                            <WrapPanel>
                                <Button Content="👕 Slim Shirt S" Command="{Binding SimulateBarcodeScanCommand}" CommandParameter="8900327943047" Background="#2563EB" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="11" Padding="8,4" Margin="0,0,6,6" BorderThickness="0" Cursor="Hand"/>
                                <Button Content="👕 Slim Shirt XL" Command="{Binding SimulateBarcodeScanCommand}" CommandParameter="8900734656318" Background="#2563EB" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="11" Padding="8,4" Margin="0,0,6,6" BorderThickness="0" Cursor="Hand"/>
                                <Button Content="👕 Casual Shirt L" Command="{Binding SimulateBarcodeScanCommand}" CommandParameter="8900450996935" Background="#2563EB" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="11" Padding="8,4" Margin="0,0,6,6" BorderThickness="0" Cursor="Hand"/>
                            </WrapPanel>
                        </StackPanel>
                    </Grid>

                    <!-- Footer -->
                    <Grid Grid.Row="2" Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="💡 Tip: In Mobile Chrome, if live video is restricted on Wi-Fi HTTP, tap 'Install APK' or enable Chrome flag: unsafely-treat-insecure-origin-as-secure." FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="Done / Close" Command="{Binding CloseMobileScannerSetupCommand}" Background="#334155" Foreground="#FFFFFF" FontWeight="SemiBold" Padding="16,8" BorderThickness="0" Cursor="Hand"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- MODAL: PRODUCT SKU BARCODE LABEL & PRINT -->
        <Grid Background="#CC000000" Grid.Row="0" Grid.RowSpan="4" Panel.ZIndex="100" Visibility="{Binding IsBarcodeLabelModalOpen, Converter={StaticResource BoolToVis}}">
            <Border Background="#1E293B" CornerRadius="10" Width="520" Padding="24" BorderBrush="#334155" BorderThickness="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="🏷 Product SKU Barcode &amp; Hang Tag Label" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF"/>
                            <TextBlock Text="Official retail price tag with SKU, Size, Color, MRP, and EAN-13/Code-128 barcode." FontSize="12" Foreground="#94A3B8" Margin="0,3,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="✕" Command="{Binding CloseBarcodeLabelModalCommand}" Background="Transparent" Foreground="#94A3B8" FontSize="18" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Padding="8,2" VerticalAlignment="Top"/>
                    </Grid>

                    <!-- Body: Visual Hang Tag Preview -->
                    <StackPanel Grid.Row="1">
                        <Border Background="#FFFFFF" CornerRadius="8" Padding="10" HorizontalAlignment="Center" BorderBrush="#475569" BorderThickness="1.5" Margin="0,0,0,12">
                            <Image Source="{Binding BarcodeLabelPreviewImage}" Width="420" Height="300" Stretch="Uniform"/>
                        </Border>
                        <TextBlock Text="{Binding BarcodeLabelPrintStatus}" Foreground="#34D399" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- Footer / Print Action Buttons -->
                    <Grid Grid.Row="2" Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="1" Content="🖨 Print 50×35mm Tag" Command="{Binding PrintBarcodeLabelCommand}" Background="#2563EB" Foreground="#FFFFFF" FontWeight="Bold" Padding="14,8" BorderThickness="0" Cursor="Hand" Margin="0,0,10,0"/>
                        <Button Grid.Column="2" Content="Close" Command="{Binding CloseBarcodeLabelModalCommand}" Background="#334155" Foreground="#FFFFFF" FontWeight="SemiBold" Padding="14,8" BorderThickness="0" Cursor="Hand"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- MODAL: RESUME HELD BILLS (F7) -->
        <Grid Background="#CC000000" Grid.Row="0" Grid.RowSpan="4" Panel.ZIndex="100" Visibility="{Binding IsHeldBillsModalOpen, Converter={StaticResource BoolToVis}}">
            <Border Background="#1E293B" CornerRadius="10" Width="600" Padding="24" BorderBrush="#334155" BorderThickness="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="⏸ Held Bills Manager (F7)" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF"/>
                        <Button Grid.Column="1" Content="✕" Command="{Binding CloseHeldBillsModalCommand}" Background="Transparent" Foreground="#94A3B8" FontSize="18" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Padding="8,2" VerticalAlignment="Top"/>
                    </Grid>
                    <Border Grid.Row="1" Background="#0F172A" CornerRadius="6" BorderBrush="#334155" BorderThickness="1" MinHeight="180">
                        <ListBox ItemsSource="{Binding HeldBills}" Background="Transparent" BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#1E293B" CornerRadius="6" Padding="12" Margin="4,3" BorderBrush="#334155" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding CustomerName}" FontWeight="Bold" FontSize="14" Foreground="#FFFFFF"/>
                                                <TextBlock Text="{Binding HeldAt, StringFormat='Held at: {0:HH:mm:ss} | {1} items'}" FontSize="12" Foreground="#94A3B8" Margin="0,3,0,0"/>
                                                <TextBlock Text="{Binding TotalAmount, StringFormat='Total: ₹{0:N2}'}" FontWeight="Bold" FontSize="13" Foreground="#10B981" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="▶ Resume Bill" Command="{Binding DataContext.ResumeHeldBillCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" Background="#2563EB" Foreground="#FFFFFF" FontWeight="Bold" Padding="14,6" BorderThickness="0" Cursor="Hand" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                    <Button Grid.Row="2" Content="Close" Command="{Binding CloseHeldBillsModalCommand}" Background="#334155" Foreground="#FFFFFF" FontWeight="SemiBold" Padding="16,8" Margin="0,14,0,0" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Right"/>
                </Grid>
            </Border>
        </Grid>

    </Grid>
</Window>
