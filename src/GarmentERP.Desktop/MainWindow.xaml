                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="👗 Product Catalog &amp; Parent-Variant Architecture" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF"/>
