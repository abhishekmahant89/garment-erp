                    <StackPanel>
                        <TextBlock Text="👥 Enroll New Customer" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,12"/>
                        <TextBlock Text="Full Name:" Foreground="#94A3B8" FontSize="11"/>
                        <TextBox Text="{Binding NewCustomerName}" Background="#0F172A" Foreground="#FFFFFF" Padding="6" Margin="0,2,0,10"/>

                        <TextBlock Text="Mobile Phone:" Foreground="#94A3B8" FontSize="11"/>
                        <TextBox Text="{Binding NewCustomerPhone}" Background="#0F172A" Foreground="#FFFFFF" Padding="6" Margin="0,2,0,10"/>

                        <TextBlock Text="Email Address:" Foreground="#94A3B8" FontSize="11"/>
                        <TextBox Text="{Binding NewCustomerEmail}" Background="#0F172A" Foreground="#FFFFFF" Padding="6" Margin="0,2,0,15"/>

                        <Button Content="Register Customer (+50 pts)" Command="{Binding CreateNewCustomerCommand}" Background="#7C3AED" Foreground="#FFFFFF" FontWeight="Bold" Padding="0,10" BorderThickness="0" Cursor="Hand"/>
                    </StackPanel>
                </Border>

