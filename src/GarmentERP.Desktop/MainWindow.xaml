                        <TextBlock Grid.Row="0" Text="Stock Transfer Manifests" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,10"/>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding TransferHistory}" AutoGenerateColumns="False" CanUserAddRows="False" Background="#0F172A" RowBackground="#1E293B" Foreground="#FFFFFF" BorderThickness="0" HeadersVisibility="Column" ColumnHeaderStyle="{StaticResource ModernDataGridColumnHeader}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="MANIFEST #" Binding="{Binding TransferNumber}" Width="150" FontWeight="SemiBold"/>
                                <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="100"/>
                                <DataGridTextColumn Header="ITEMS" Binding="{Binding ItemCount}" Width="80"/>
                                <DataGridTemplateColumn Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Receive" Command="{Binding DataContext.ReceiveTransferCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Background="#059669" Foreground="#FFFFFF" Padding="6,2" BorderThickness="0" Cursor="Hand"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>

            <!-- ==================================================== -->
