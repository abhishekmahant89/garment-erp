                                <DataGridTextColumn Header="CUSTOMER NAME" Binding="{Binding Name}" Width="180" FontWeight="SemiBold"/>
                                <DataGridTextColumn Header="PHONE" Binding="{Binding Phone}" Width="130"/>
                                <DataGridTextColumn Header="LOYALTY POINTS" Binding="{Binding LoyaltyPoints}" Width="120" FontWeight="Bold"/>
                                <DataGridTextColumn Header="EMAIL" Binding="{Binding Email}" Width="*"/>
